# ─────────────────────────────────────────────────────────────
# 환경변수 템플릿. 복사해서 실제 값을 채운다:
#   cp .env.example .env.local     (.env.local 은 .gitignore 대상)
#
# 이 저장소는 현재 public 이다. 실제 프로젝트 URL·키는 이 파일에 쓰지 말 것.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_PROJECT_REF=your-project-ref

# 브라우저에 노출되는 값 (RLS 로 보호되는 경로에서만 사용)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# INV-5: 서버 전용. RLS 를 우회하므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
#        클라이언트 번들·로그·에러 응답에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database ────────────────────────────────────────────────
# 프라이머리 — 재고 차감·예약 상태 전이·정산 (INV-12)
# 상시 컨테이너이므로 직결(5432) + 앱측 풀. prepared statement 를 유지하기 위함.
# (IPv4 전용 네트워크면 Supavisor session mode 문자열로 대체)
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# 마이그레이션 전용 — DDL·advisory lock 안정성 때문에 분리 관리
DIRECT_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# 읽기 복제본 — 캘린더 조회·리포트 전용. 비동기 복제라 지연이 있다 (INV-12).
# 미설정 시 프라이머리로 폴백.
REPLICA_DATABASE_URL=

# 앱측 커넥션 풀 크기 (풀 크기 × 인스턴스 수 ≤ compute 등급 커넥션 상한)
DB_POOL_MAX=20

# ── Redis (캐시 + BullMQ) ───────────────────────────────────
REDIS_URL=redis://localhost:6379
AVAILABILITY_CACHE_TTL_SECONDS=60

# ── 관측 (Rule #16 성능 예산 검증) ──────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ta-api
SENTRY_DSN=

# ── 앱 ──────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
OCTO_GATEWAY_PORT=4100
PORTAL_PORT=3000
CONSOLE_PORT=3001
FIELD_PORT=3002

# ── 채널 연동 (Phase 2~) ────────────────────────────────────
# OCTO 파트너 웹훅 서명 시크릿 — 서버 전용
OCTO_WEBHOOK_SIGNING_SECRET=
