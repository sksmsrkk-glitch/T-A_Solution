# ─────────────────────────────────────────────────────────────
# 환경변수 템플릿. 복사해서 실제 값을 채운다:
#   cp .env.example .env.local     (.env.local 은 .gitignore 대상)
#
# 이 저장소는 현재 public 이다. 실제 프로젝트 URL·키는 이 파일에 쓰지 말 것.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_PROJECT_REF=your-project-ref

# 브라우저에 노출되는 값 (RLS 로 보호되는 경로에서만 사용)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# INV-5: 서버 전용. RLS 를 우회하므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
#        클라이언트 번들·로그·에러 응답에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database ────────────────────────────────────────────────
# 애플리케이션 커넥션 — Supavisor 풀러 (transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 마이그레이션 전용 — 직결 (session mode, port 5432)
# 풀러 transaction mode 에서는 DDL·advisory lock 이 제대로 동작하지 않는다.
DIRECT_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── 앱 ──────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
OCTO_GATEWAY_PORT=4100
PORTAL_PORT=3000
CONSOLE_PORT=3001
FIELD_PORT=3002

# ── 채널 연동 (Phase 2~) ────────────────────────────────────
# OCTO 파트너 웹훅 서명 시크릿 — 서버 전용
OCTO_WEBHOOK_SIGNING_SECRET=
